# Create a key at https://londonstrategicedge.com/data
LSE_API_KEY=

# Optional Lot 2 collectors; never required for local feature calculations/replay.
FRED_API_KEY=
EIA_API_KEY=

# Optional Lot 4: no key required for cached/offline replay.
OPENDART_API_KEY=
ESTAT_APP_ID=

# Optional alternative security directory; SEC/Nasdaq snapshots need no API key.
ALPHAVANTAGE_API_KEY=

# Lot 5: COT needs no key; licensed estimates use explicit exports/client.
# Prospective option chains reuse LSE_API_KEY. No new mandatory credential.

# Optional conflict collector: free token requested via https://ucdp.uu.se/apidocs/
# Not needed for calendars, election cycles, imported histories or cache replay.
UCDP_API_TOKEN=
